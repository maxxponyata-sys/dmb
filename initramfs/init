#!/bin/busybox sh
# dmb initramfs: find the root partition by its GPT label, mount it and
# switch_root into Debian. On any failure (or with dmb.debug on the kernel
# command line) start a USB debug console instead:
#   - serial: a COM port on the PC (115200), shell on ttyGS0
#   - network: RNDIS, phone 172.16.42.1, telnet port 23
/bin/busybox --install -s /bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	# Kernels without devtmpfs: let busybox mdev create the nodes
	mount -t tmpfs -o mode=0755 tmpfs /dev
	echo /bin/mdev > /proc/sys/kernel/hotplug
	mdev -s
fi
mkdir -p /dev/pts /run /sysroot
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run

. /etc/dmb-initramfs.conf

say() {
	echo "dmb: $*" > /dev/kmsg
	echo "dmb: $*" > /dev/tty0 2>/dev/null
	echo "dmb: $*" >> /run/dmb-initramfs.log
}

cmdline_get() {
	local w
	for w in $(cat /proc/cmdline); do
		case "$w" in "$1"=*) echo "${w#*=}"; return 0 ;; esac
	done
	return 1
}

# Print the /dev node of the partition with GPT name $1
find_partlabel() {
	local u
	for u in /sys/class/block/*/uevent; do
		if grep -qx "PARTNAME=$1" "$u"; then
			echo "/dev/$(sed -n 's/^DEVNAME=//p' "$u")"
			return 0
		fi
	done
	return 1
}

usb_gadget() {
	local g=/sys/kernel/config/usb_gadget/dmb udc
	mount -t configfs configfs /sys/kernel/config 2>/dev/null
	[ -d /sys/kernel/config/usb_gadget ] || { say "no configfs usb_gadget"; return 1; }
	mkdir -p $g
	echo "$USB_VID" > $g/idVendor
	echo "$USB_PID" > $g/idProduct
	mkdir -p $g/strings/0x409
	echo "dmb" > $g/strings/0x409/manufacturer
	echo "$DEVICE_NAME (dmb debug)" > $g/strings/0x409/product
	echo "dmb-$DEVICE" > $g/strings/0x409/serialnumber

	mkdir -p $g/configs/c.1/strings/0x409
	echo "rndis + serial" > $g/configs/c.1/strings/0x409/configuration

	# Windows binds RNDIS without a driver when it sees these OS descriptors
	echo 1 > $g/os_desc/use
	echo 0xcd > $g/os_desc/b_vendor_code
	echo MSFT100 > $g/os_desc/qw_sign
	if mkdir -p $g/functions/rndis.usb0 2>/dev/null; then
		echo RNDIS > $g/functions/rndis.usb0/os_desc/interface.rndis/compatible_id
		echo 5162001 > $g/functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id
		ln -s $g/functions/rndis.usb0 $g/configs/c.1/
		ln -s $g/configs/c.1 $g/os_desc/
	fi
	mkdir -p $g/functions/acm.gs0 2>/dev/null && ln -s $g/functions/acm.gs0 $g/configs/c.1/

	udc="$(ls /sys/class/udc 2>/dev/null | head -n1)"
	[ -n "$udc" ] || { say "no USB device controller"; return 1; }
	echo "$udc" > $g/UDC
	say "USB gadget up on $udc"
}

debug_shell() {
	say "debug shell: $*"
	usb_gadget
	sleep 2
	if ip link set usb0 up 2>/dev/null; then
		ip addr add 172.16.42.1/24 dev usb0
		mkdir -p /var/lib/misc
		cat > /etc/udhcpd.conf <<-EOF
		start 172.16.42.2
		end 172.16.42.2
		interface usb0
		option subnet 255.255.255.0
		EOF
		touch /var/lib/misc/udhcpd.leases
		udhcpd /etc/udhcpd.conf
		telnetd -l /bin/sh -p 23
		say "telnet 172.16.42.1 (RNDIS)"
	fi
	# Shell on the USB serial port and on the screen
	[ -e /dev/ttyGS0 ] && setsid sh -c 'exec getty -n -l /bin/sh 115200 ttyGS0' &
	say "logs: /run/dmb-initramfs.log, dmesg"
	setsid sh -c 'exec sh </dev/tty0 >/dev/tty0 2>&1' &
	while true; do sleep 3600; done
}

say "initramfs for $DEVICE, kernel $(uname -r)"

cmdline_get dmb.debug >/dev/null && debug_shell "requested by dmb.debug"

label="$(cmdline_get dmb.root || echo "$ROOT_PARTLABEL")"
root=""
i=0
while [ $i -lt 30 ]; do
	root="$(find_partlabel "$label")" && break
	sleep 1
	i=$((i + 1))
done
[ -n "$root" ] || debug_shell "partition '$label' not found (storage driver?)"
say "root partition $label = $root"

# Look first without writing anything (noload: no journal replay), so a
# partition that still holds Android's data is left untouched
mount -t ext4 -o ro,noload "$root" /sysroot || debug_shell "cannot mount $root as ext4"
found=0
[ -f /sysroot/etc/dmb-release ] && found=1
umount /sysroot
[ $found = 1 ] || debug_shell "$root holds no dmb rootfs (not flashed yet?)"
mount -t ext4 -o rw,noatime "$root" /sysroot || debug_shell "cannot mount $root read-write"

cp /run/dmb-initramfs.log /sysroot/var/log/dmb-initramfs.log 2>/dev/null
umount /dev/pts
mount --move /dev /sysroot/dev
mount --move /run /sysroot/run
umount /proc /sys
exec switch_root /sysroot /sbin/init
