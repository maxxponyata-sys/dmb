
# --- dmb: options the generic initramfs and Debian userspace rely on ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_MSM=y
CONFIG_AUTOFS_FS=y
CONFIG_CGROUPS=y
CONFIG_SECCOMP=y
CONFIG_FHANDLE=y
CONFIG_TMPFS_POSIX_ACL=y
# USB gadget for the debug shell (NCM network + serial console)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP_COMBO=y
# Qualcomm bootloaders can leave the APSS watchdog running; the driver must
# be built in so the kernel keeps petting it before any module can load
# (WATCHDOG_HANDLE_BOOT_ENABLED), or the phone resets after ~10 seconds
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_QCOM_WDT=y
# Keep the last kernel log across a reboot (read it from /sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
