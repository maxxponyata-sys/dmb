#!/bin/sh
# Copy the Samsung-signed firmware that cannot be redistributed from the
# phone's own partitions into /lib/firmware, squashing the split
# .mdt/.bNN files into the .mbn files the mainline kernel loads:
#   vendor  (ext4): firmware/a615_zap.*   GPU zap shader, needed by freedreno
#   apnhlos (vfat): image/{adsp,cdsp,modem}.*, image/wlanmdsp.mbn,
#                   WCN3990 board data    DSPs and Wi-Fi (boot-wifi)
# Run once as root, then reboot.
set -eu
dst=/lib/firmware/qcom/sm7150/samsung/r1q
work=$(mktemp -d)
vendor=$work/vendor
apnhlos=$work/apnhlos

cleanup() {
	umount "$vendor" 2>/dev/null || true
	umount "$apnhlos" 2>/dev/null || true
	rm -rf "$work"
}
trap cleanup EXIT

for p in vendor apnhlos; do
	[ -e "/dev/disk/by-partlabel/$p" ] || { echo "no partition '$p'"; exit 1; }
	mkdir -p "$work/$p"
	mount -o ro "/dev/disk/by-partlabel/$p" "$work/$p"
done
mkdir -p $dst

for fw in a615_zap adsp cdsp modem; do
	src=""
	for d in "$vendor/firmware" "$apnhlos/image"; do
		[ -f "$d/$fw.mdt" ] && { src="$d/$fw.mdt"; break; }
	done
	if [ -n "$src" ]; then
		pil-squasher "$dst/$fw.mbn" "$src"
		echo "installed $dst/$fw.mbn (from $src)"
	else
		echo "skipped $fw (not found)"
	fi
done

# WLAN firmware for the modem; tqftpserv hands it out from the modem's
# firmware directory
if [ -f "$apnhlos/image/wlanmdsp.mbn" ]; then
	cp "$apnhlos/image/wlanmdsp.mbn" $dst/
	echo "installed $dst/wlanmdsp.mbn"
fi

# Board data for ath10k: board-2.bin from firmware-atheros has no r1q
# entry, so ath10k falls back to board.bin
bd=""
for f in "$apnhlos/image/bdwlan.bin" "$vendor/firmware/wlan/qca_cld/bdwlan.bin" \
	"$apnhlos/image/bdwlan.b0c" "$apnhlos/image/bdwlan.elf"; do
	[ -f "$f" ] && { bd="$f"; break; }
done
if [ -n "$bd" ]; then
	mkdir -p /lib/firmware/ath10k/WCN3990/hw1.0
	cp "$bd" /lib/firmware/ath10k/WCN3990/hw1.0/board.bin
	echo "installed ath10k board.bin (from $bd)"
else
	echo "no WCN3990 board data found; these are the candidates:"
	ls "$apnhlos/image" | grep -i -E "bd|wlan" || true
fi

echo "done; reboot to use them"
