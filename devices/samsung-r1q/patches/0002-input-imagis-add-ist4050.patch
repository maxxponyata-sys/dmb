diff --git a/drivers/input/touchscreen/imagis.c b/drivers/input/touchscreen/imagis.c
--- a/drivers/input/touchscreen/imagis.c
+++ b/drivers/input/touchscreen/imagis.c
@@ -44,13 +44,34 @@
 #define IST3038C_FINGER_STATUS_MASK	GENMASK(9, 0)
 #define IST3032C_KEY_STATUS_MASK	GENMASK(20, 16)
 
+/*
+ * IST40xx: same HIB registers as the IST3038C, but each finger is two
+ * words read in one burst, carries its own id and state, and the chip
+ * has to be put in 32-bit I2C mode after power-on.
+ */
+#define IST40XX_WHOAMI			0x4050
+#define IST40XX_REG_I2C_CTRL		(0x30000000 | IST3038C_DIRECT_ACCESS)
+#define IST40XX_I2C_32BIT_MODE		0x003912d8
+#define IST40XX_BURST_ACCESS		BIT(27)
+#define IST40XX_MAX_FINGER_NUM		15
+#define IST40XX_INTR_TOUCH		BIT(11)
+#define IST40XX_Y_MASK			GENMASK(11, 0)
+#define IST40XX_X_MASK			GENMASK(23, 12)
+#define IST40XX_STATE_MASK		GENMASK(27, 24)
+#define IST40XX_ID_MASK			GENMASK(31, 28)
+#define IST40XX_AREA_MASK		GENMASK(3, 0)
+#define IST40XX_STATE_PRESS		1
+#define IST40XX_STATE_RELEASE		2
+
 struct imagis_properties {
 	unsigned int interrupt_msg_cmd;
 	unsigned int touch_coord_cmd;
 	unsigned int whoami_cmd;
 	unsigned int whoami_val;
+	unsigned int whoami_mask;
 	bool protocol_b;
 	bool touch_keys_supported;
+	bool ist40xx;
 };
 
 struct imagis_ts {
@@ -101,6 +122,101 @@
 	return error;
 }
 
+static int imagis_i2c_write_reg(struct imagis_ts *ts, unsigned int reg, u32 val)
+{
+	__be32 buf[2] = { cpu_to_be32(reg), cpu_to_be32(val) };
+	int ret;
+
+	ret = i2c_master_send(ts->client, (char *)buf, sizeof(buf));
+	if (ret == sizeof(buf))
+		return 0;
+
+	return ret < 0 ? ret : -EIO;
+}
+
+static int imagis_i2c_burst_read(struct imagis_ts *ts, unsigned int reg,
+				 __be32 *buf, unsigned int words)
+{
+	__be32 reg_be = cpu_to_be32(reg | IST40XX_BURST_ACCESS);
+	struct i2c_msg msg[] = {
+		{
+			.addr = ts->client->addr,
+			.flags = 0,
+			.buf = (unsigned char *)&reg_be,
+			.len = sizeof(reg_be),
+		}, {
+			.addr = ts->client->addr,
+			.flags = I2C_M_RD,
+			.buf = (unsigned char *)buf,
+			.len = words * sizeof(*buf),
+		},
+	};
+	int ret;
+
+	ret = i2c_transfer(ts->client->adapter, msg, ARRAY_SIZE(msg));
+	if (ret == ARRAY_SIZE(msg))
+		return 0;
+
+	return ret < 0 ? ret : -EIO;
+}
+
+static irqreturn_t imagis_40xx_interrupt(int irq, void *dev_id)
+{
+	struct imagis_ts *ts = dev_id;
+	__be32 coord[IST40XX_MAX_FINGER_NUM * 2];
+	unsigned int count, state, id, i;
+	u32 intr_message, w0, w1;
+	int error;
+
+	error = imagis_i2c_read_reg(ts, ts->tdata->interrupt_msg_cmd, &intr_message);
+	if (error) {
+		dev_err(&ts->client->dev,
+			"failed to read the interrupt message: %d\n", error);
+		return IRQ_HANDLED;
+	}
+
+	/* Calibration, exception and other non-touch messages */
+	if (!(intr_message & IST40XX_INTR_TOUCH) || intr_message == 0xffffffff)
+		return IRQ_HANDLED;
+
+	count = FIELD_GET(IST3038C_FINGER_COUNT_MASK, intr_message);
+	if (!count || count > IST40XX_MAX_FINGER_NUM)
+		return IRQ_HANDLED;
+
+	error = imagis_i2c_burst_read(ts, ts->tdata->touch_coord_cmd, coord, count * 2);
+	if (error) {
+		dev_err(&ts->client->dev, "failed to read coordinates: %d\n", error);
+		return IRQ_HANDLED;
+	}
+
+	for (i = 0; i < count; i++) {
+		w0 = be32_to_cpu(coord[i * 2]);
+		w1 = be32_to_cpu(coord[i * 2 + 1]);
+		state = FIELD_GET(IST40XX_STATE_MASK, w0);
+		id = FIELD_GET(IST40XX_ID_MASK, w0);
+
+		/* ids are 1-based; other states carry no new position */
+		if (!id || (state != IST40XX_STATE_PRESS && state != IST40XX_STATE_RELEASE))
+			continue;
+
+		input_mt_slot(ts->input_dev, id - 1);
+		input_mt_report_slot_state(ts->input_dev, MT_TOOL_FINGER,
+					   state == IST40XX_STATE_PRESS);
+		if (state == IST40XX_STATE_PRESS) {
+			touchscreen_report_pos(ts->input_dev, &ts->prop,
+					       FIELD_GET(IST40XX_X_MASK, w0),
+					       FIELD_GET(IST40XX_Y_MASK, w0), true);
+			input_report_abs(ts->input_dev, ABS_MT_TOUCH_MAJOR,
+					 FIELD_GET(IST40XX_AREA_MASK, w1));
+		}
+	}
+
+	input_mt_sync_frame(ts->input_dev);
+	input_sync(ts->input_dev);
+
+	return IRQ_HANDLED;
+}
+
 static irqreturn_t imagis_interrupt(int irq, void *dev_id)
 {
 	struct imagis_ts *ts = dev_id;
@@ -182,6 +298,17 @@
 
 	msleep(IST3038C_CHIP_ON_DELAY_MS);
 
+	if (ts->tdata->ist40xx) {
+		error = imagis_i2c_write_reg(ts, IST40XX_REG_I2C_CTRL,
+					     IST40XX_I2C_32BIT_MODE);
+		if (error) {
+			dev_err(&ts->client->dev,
+				"failed to set 32-bit I2C mode: %d\n", error);
+			regulator_bulk_disable(ARRAY_SIZE(ts->supplies), ts->supplies);
+			return error;
+		}
+	}
+
 	return 0;
 }
 
@@ -268,9 +395,13 @@
 		return -EINVAL;
 	}
 
-	error = input_mt_init_slots(input_dev,
-				    IST3038C_MAX_FINGER_NUM,
-				    INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ts->tdata->ist40xx)
+		error = input_mt_init_slots(input_dev, IST40XX_MAX_FINGER_NUM,
+					    INPUT_MT_DIRECT);
+	else
+		error = input_mt_init_slots(input_dev,
+					    IST3038C_MAX_FINGER_NUM,
+					    INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
 	if (error) {
 		dev_err(&ts->client->dev,
 			"Failed to initialize MT slots: %d", error);
@@ -340,13 +471,17 @@
 		return error;
 	}
 
+	if (ts->tdata->whoami_mask)
+		chip_id &= ts->tdata->whoami_mask;
+
 	if (chip_id != ts->tdata->whoami_val) {
 		dev_err(dev, "unknown chip ID: 0x%x\n", chip_id);
 		return -EINVAL;
 	}
 
 	error = devm_request_threaded_irq(dev, i2c->irq,
-					  NULL, imagis_interrupt,
+					  NULL, ts->tdata->ist40xx ?
+					  imagis_40xx_interrupt : imagis_interrupt,
 					  IRQF_ONESHOT | IRQF_NO_AUTOEN,
 					  "imagis-touchscreen", ts);
 	if (error) {
@@ -438,12 +573,22 @@
 	.whoami_val = IST3038H_WHOAMI,
 };
 
+static const struct imagis_properties imagis_40xx_data = {
+	.interrupt_msg_cmd = IST3038C_REG_INTR_MESSAGE,
+	.touch_coord_cmd = IST3038C_REG_TOUCH_COORD,
+	.whoami_cmd = IST3038C_REG_CHIPID,
+	.whoami_val = IST40XX_WHOAMI,
+	.whoami_mask = 0xffff,
+	.ist40xx = true,
+};
+
 static const struct of_device_id imagis_of_match[] = {
 	{ .compatible = "imagis,ist3032c", .data = &imagis_3032c_data },
 	{ .compatible = "imagis,ist3038", .data = &imagis_3038_data },
 	{ .compatible = "imagis,ist3038b", .data = &imagis_3038b_data },
 	{ .compatible = "imagis,ist3038c", .data = &imagis_3038c_data },
 	{ .compatible = "imagis,ist3038h", .data = &imagis_3038h_data },
+	{ .compatible = "imagis,ist4050", .data = &imagis_40xx_data },
 	{ },
 };
 MODULE_DEVICE_TABLE(of, imagis_of_match);
