// SPDX-License-Identifier: BSD-3-Clause
/*
 * Samsung Galaxy A80 (r1q), stage 2: the stage-1 board plus the display
 * pipeline (MDSS/DPU, DSI0, AMS628RF05 panel) and the IST4050
 * touchscreen. Kept as its own DTB so
 * the stage-1 image, with the bootloader's framebuffer only, stays a
 * known fallback.
 *
 * Panel wiring from the stock DTBO (ss_dsi_panel_S6E3FC2_AMS670TA01_FHD):
 * reset TLMM 11, enable TLMM 69, TE TLMM 10, VDDIO L13A. ELVDD/ELVSS come
 * from the PM6150L AMOLED block, left on by the bootloader.
 */

#include "sm7150-samsung-r1q.dts"

/ {
	model = "Samsung Galaxy A80 (display)";

	/*
	 * The touchscreen is wired to QUP SE7 (i2c7, TLMM 6 SDA / 7 SCL),
	 * but any transfer on that serial engine, through GPI DMA or its
	 * FIFO, resets the phone at once (a bare chip-ID read from userspace
	 * is enough). Bit-bang the same two lines instead.
	 */
	i2c-touch {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 6 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 7 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;	/* about 250 kHz */

		pinctrl-0 = <&ts_i2c_gpio>;
		pinctrl-names = "default";

		#address-cells = <1>;
		#size-cells = <0>;

		/* Stock: imagis,ist40xx-ts, AVDD from L18A, IRQ on TLMM 9 */
		touchscreen@50 {
			compatible = "imagis,ist4050";
			reg = <0x50>;

			interrupts-extended = <&tlmm 9 IRQ_TYPE_EDGE_FALLING>;

			vdd-supply = <&vreg_l18a_3p0>;
			vddio-supply = <&vreg_l13a_1p8>;

			touchscreen-size-x = <1080>;
			touchscreen-size-y = <2400>;

			pinctrl-0 = <&ts_int_n>;
			pinctrl-names = "default";
		};
	};
};

&dispcc {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3c_1p23>;
	status = "okay";

	panel@0 {
		compatible = "samsung,ams628rf05";
		reg = <0>;

		vddio-supply = <&vreg_l13a_1p8>;
		reset-gpios = <&tlmm 11 GPIO_ACTIVE_LOW>;
		/*
		 * The stock enable line is TLMM 69, inside the 63-90 range still
		 * reserved as TrustZone-owned. The bootloader leaves the panel
		 * powered, so leave it alone until 69 is known to be free:
		 * enable-gpios = <&tlmm 69 GPIO_ACTIVE_HIGH>;
		 */

		pinctrl-0 = <&panel_reset_n &mdp_vsync_p>;
		pinctrl-names = "default";

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	data-lanes = <0 1 2 3>;
	remote-endpoint = <&panel_in>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l4a_0p88>;
	status = "okay";
};

&tlmm {
	mdp_vsync_p: mdp-vsync-p-state {
		pins = "gpio10";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	panel_reset_n: panel-reset-n-state {
		pins = "gpio11";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	ts_int_n: ts-int-n-state {
		pins = "gpio9";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_i2c_gpio: ts-i2c-gpio-state {
		pins = "gpio6", "gpio7";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};
